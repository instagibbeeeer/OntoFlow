{
  "classes": ["Machine", "Station", "Part", "Batch", "Order", "QualityEvent", "MaintenanceAction", "Document"],
  "relationships": [
    {"name": "runs_on", "from": "Batch", "to": "Machine"},
    {"name": "belongs_to", "from": "Batch", "to": "Order"},
    {"name": "affects", "from": "QualityEvent", "to": "Part"},
    {"name": "reported_for", "from": "QualityEvent", "to": "Batch"}
  ],
  "rules": {
    "required_by_type": {
      "production_event": ["event_id", "event_type", "machine_id", "timestamp", "source_system"],
      "quality_event": ["event_id", "batch_id", "station_id", "severity", "timestamp", "source_system"],
      "maintenance_action": ["event_id", "machine_id", "action_type", "timestamp", "source_system"],
      "document": ["document_id", "title", "text", "source_system"]
    },
    "allowed_severity": ["low", "medium", "high", "critical"]
  },
  "quality_weights": {"completeness": 0.5, "conformity": 0.3, "recency": 0.2}
}
